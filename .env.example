# Google Sheets: recomanats i stock
# Ruta al fitxer JSON del Service Account (Google Cloud Console)
GOOGLE_APPLICATION_CREDENTIALS=./back-end/config/techshop-sheets-credentials.json

# ID del full de Google Sheets (de la URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit)
TECHSHOP_SPREADSHEET_ID=

# Nom de la pestanya dins del document (opcional; per defecte: "Recomanats i Stock")
# TECHSHOP_SHEET_NAME=Recomanats i Stock
